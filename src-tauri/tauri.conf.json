{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CWLD",
  "version": "0.19.3",
  "identifier": "io.github.on3vz.cwld",
  "build": {
    "beforeDevCommand": "npm --prefix ui run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm --prefix ui run build",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "CWLD",
        "width": 1180,
        "height": 760,
        "minWidth": 720,
        "minHeight": 520,
        "maximized": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; media-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./windows/hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJERjI4QjE1M0U5QTYxNDEKUldSQllabytGWXZ5dldyb3V3Z1Via000OTczTlg4cnVBOVVQcCtXdlU5dUZUVFdVN3RJcWNRaWYK",
      "endpoints": [
        "https://github.com/ON3VZ/CWLD_DECODE/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
